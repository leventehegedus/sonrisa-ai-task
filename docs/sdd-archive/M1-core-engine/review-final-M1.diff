index 0000000..3d2850d
--- /dev/null
+++ b/server/src/geo/index.ts
@@ -0,0 +1,31 @@
+import { readFileSync } from 'node:fs';
+
+export interface Country { iso2: string; iso3: string; region: string; subregion: string }
+
+// Minimal CSV line split: handles double-quoted fields containing commas.
+// shortcut: no escaped quotes inside fields (none in the M49 file), swap for a CSV lib if the data changes.
+function splitLine(line: string): string[] {
+  const out: string[] = [];
+  let cur = '', quoted = false;
+  for (const ch of line) {
+    if (ch === '"') quoted = !quoted;
+    else if (ch === ',' && !quoted) { out.push(cur); cur = ''; }
+    else cur += ch;
+  }
+  out.push(cur);
+  return out;
+}
+
+const byIso2 = new Map<string, Country>();
+const iso3Map = new Map<string, string>();
+const lines = readFileSync(new URL('./m49.csv', import.meta.url), 'utf8').split(/\r?\n/);
+for (const line of lines.slice(1)) {
+  if (!line.trim()) continue;
+  const f = splitLine(line);
+  const c: Country = { iso2: f[1]!, iso3: f[2]!, region: f[5]!, subregion: f[6]! };
+  byIso2.set(c.iso2, c);
+  iso3Map.set(c.iso3, c.iso2);
+}
+
+export const lookupCountry = (iso2: string): Country | undefined => byIso2.get(iso2);
+export const iso3ToIso2 = (iso3: string): string | undefined => iso3Map.get(iso3);
diff --git a/server/src/matching/index.ts b/server/src/matching/index.ts
new file mode 100644
index 0000000..ba89df7
--- /dev/null
+++ b/server/src/matching/index.ts
@@ -0,0 +1,20 @@
+import { score } from '../scoring';
+import type { EventRow, NewEvent, Rule, ScoreBreakdown, User } from '../types';
+
+const lower = (s: string) => s.toLocaleLowerCase('hu');
+
+export function matchesContent(
+  rule: Pick<Rule, 'categories' | 'keywords'>,
+  event: Pick<NewEvent, 'category' | 'title' | 'summary'>,
+): boolean {
+  if (rule.categories.length && !rule.categories.includes(event.category)) return false;
+  const keywords = rule.keywords.map((k) => lower(k.trim())).filter(Boolean);
+  if (!keywords.length) return true;
+  const text = lower(`${event.title} ${event.summary ?? ''}`);
+  return keywords.some((k) => text.includes(k));
+}
+
+export function evaluate(rule: Rule, user: User, event: EventRow): ScoreBreakdown | null {
+  if (!rule.enabled || !matchesContent(rule, event)) return null;
+  return score(event, user.homeCountry, rule.threshold);
+}
diff --git a/server/src/pipeline/dispatch.ts b/server/src/pipeline/dispatch.ts
new file mode 100644
index 0000000..e1a4e9e
--- /dev/null
+++ b/server/src/pipeline/dispatch.ts
@@ -0,0 +1,54 @@
+import type { Database } from 'better-sqlite3';
+import { buildMessage, scrubSecrets, type ChannelAdapter } from '../channels';
+import { rowToEvent } from '../db/rows';
+import type { ScoreBreakdown } from '../types';
+
+export const MAX_ATTEMPTS = 3;
+const BASE_BACKOFF_MS = 30_000;
+const BATCH = 50;
+
+export async function dispatchPending(db: Database, registry: Record<string, ChannelAdapter<any>>, now: Date): Promise<{ sent: number; failed: number; retried: number }> {
+  const ts = now.toISOString();
+  const due = db.prepare(
+    `SELECT d.*, c.type AS c_type, c.config AS c_config, c.enabled AS c_enabled
+     FROM deliveries d LEFT JOIN channels c ON c.id = d.channel_id
+     WHERE d.status = 'pending' AND d.next_attempt_at <= ? ORDER BY d.next_attempt_at, d.id LIMIT ${BATCH}`,
+  ).all(ts) as any[];
+  const getEvent = db.prepare(`SELECT * FROM events WHERE id = ?`);
+  const markFailed = db.prepare(`UPDATE deliveries SET status = 'failed', last_error = ? WHERE id = ?`);
+  const markSent = db.prepare(`UPDATE deliveries SET status = 'sent', sent_at = ?, last_error = NULL, attempts = attempts + 1 WHERE id = ?`);
+  const markError = db.prepare(`UPDATE deliveries SET status = ?, attempts = ?, last_error = ?, next_attempt_at = ? WHERE id = ?`);
+  const out = { sent: 0, failed: 0, retried: 0 };
+
+  for (const d of due) {
+    const fail = (why: string) => { markFailed.run(why, d.id); out.failed++; };
+    if (d.channel_id === null) { fail('channel deleted'); continue; }
+    if (!d.c_enabled) { fail('channel disabled'); continue; }
+    const adapter = registry[d.c_type];
+    if (!adapter) { fail(`unknown channel type ${d.c_type}`); continue; }
+    let parsed;
+    try { parsed = adapter.configSchema.safeParse(JSON.parse(d.c_config)); } catch { parsed = null; }
+    if (!parsed?.success) { fail('invalid channel config'); continue; }
+    const config = parsed.data;
+
+    let msg;
+    try { msg = buildMessage(rowToEvent(getEvent.get(d.event_id)), JSON.parse(d.score_breakdown) as ScoreBreakdown); } catch { fail('corrupt delivery data'); continue; }
+
+    try {
+      await adapter.send(config, msg);
+    } catch (err: any) {
+      const attempts = d.attempts + 1;
+      const last = scrubSecrets(String(err?.message ?? err), config);
+      if (attempts >= MAX_ATTEMPTS) { markError.run('failed', attempts, last, d.next_attempt_at, d.id); out.failed++; }
+      else {
+        markError.run('pending', attempts, last, new Date(now.getTime() + BASE_BACKOFF_MS * 2 ** (attempts - 1)).toISOString(), d.id);
+        out.retried++;
+      }
+      continue;
+    }
+    // Outside the send try: a DB error here must not be routed into retry (would duplicate the alert).
+    markSent.run(ts, d.id);
+    out.sent++;
+  }
+  return out;
+}
diff --git a/server/src/pipeline/ingest.ts b/server/src/pipeline/ingest.ts
new file mode 100644
index 0000000..bf5055d
--- /dev/null
+++ b/server/src/pipeline/ingest.ts
@@ -0,0 +1,42 @@
+import type { Database } from 'better-sqlite3';
+import { evaluate } from '../matching';
+import { rowToEvent, rowToRule, rowToUser } from '../db/rows';
+import type { EventRow, NewEvent } from '../types';
+
+export function ingest(db: Database, events: NewEvent[], now: Date): { inserted: EventRow[]; deliveriesCreated: number } {
+  const insertEvent = db.prepare(
+    `INSERT OR IGNORE INTO events (source, external_id, category, title, summary, url, country, scope, severity, occurred_at, raw)
+     VALUES (@source, @externalId, @category, @title, @summary, @url, @country, @scope, @severity, @occurredAt, @raw)
+     RETURNING *`,
+  );
+  const insertDelivery = db.prepare(
+    `INSERT OR IGNORE INTO deliveries (rule_id, event_id, channel_id, status, attempts, score, score_breakdown, created_at, next_attempt_at)
+     VALUES (?, ?, ?, 'pending', 0, ?, ?, ?, ?)`,
+  );
+  // Only enabled channels owned by the rule's user may receive deliveries.
+  const channelOk = db.prepare(`SELECT 1 FROM channels WHERE id = ? AND user_id = ? AND enabled = 1`);
+
+  return db.transaction(() => {
+    const users = new Map(db.prepare(`SELECT * FROM users`).all().map((r) => [(r as any).id as number, rowToUser(r)]));
+    const rules = db.prepare(`SELECT * FROM rules WHERE enabled = 1`).all().map(rowToRule);
+    const ts = now.toISOString();
+    const inserted: EventRow[] = [];
+    let deliveriesCreated = 0;
+    for (const e of events) {
+      const row = insertEvent.get({ ...e, raw: JSON.stringify(e.raw ?? null) });
+      if (!row) continue;
+      const event = rowToEvent(row);
+      inserted.push(event);
+      for (const rule of rules) {
+        const user = users.get(rule.userId);
+        const b = user && evaluate(rule, user, event);
+        if (!b || !b.fires) continue;
+        for (const channelId of rule.channelIds) {
+          if (!channelOk.get(channelId, rule.userId)) continue;
+          deliveriesCreated += insertDelivery.run(rule.id, event.id, channelId, b.importance, JSON.stringify(b), ts, ts).changes;
+        }
+      }
+    }
+    return { inserted, deliveriesCreated };
+  })();
+}
diff --git a/server/src/pipeline/poll.ts b/server/src/pipeline/poll.ts
new file mode 100644
index 0000000..a1ce3db
--- /dev/null
+++ b/server/src/pipeline/poll.ts
@@ -0,0 +1,51 @@
+import type { Database } from 'better-sqlite3';
+import { sourceAdapters } from '../sources';
+import { ingest } from './ingest';
+
+const FETCH_TIMEOUT_MS = 15_000;
+const MAX_ERROR_LEN = 500;
+
+/** Fetch one source, normalize and ingest it. Never throws: failures land in `sources.last_error`. */
+export async function pollSource(db: Database, sourceId: number, deps: { fetchImpl: typeof fetch; now: () => Date }): Promise<{ ok: boolean; inserted: number; error?: string }> {
+  let row: any;
+  try {
+    row = db.prepare(`SELECT * FROM sources WHERE id = ?`).get(sourceId);
+  } catch (err) {
+    return { ok: false, inserted: 0, error: message(err) };
+  }
+  if (!row) return { ok: false, inserted: 0, error: 'source not found' };
+
+  let inserted = 0;
+  let error: string | null = null;
+  try {
+    inserted = await fetchAndIngest(db, row, deps);
+  } catch (err) {
+    error = message(err);
+  }
+  try {
+    db.prepare(`UPDATE sources SET last_polled_at = ?, last_error = ? WHERE id = ?`).run(deps.now().toISOString(), error, sourceId);
+  } catch (err) {
+    error ??= message(err);
+  }
+  return error === null ? { ok: true, inserted } : { ok: false, inserted: 0, error };
+}
+
+async function fetchAndIngest(db: Database, row: any, deps: { fetchImpl: typeof fetch; now: () => Date }): Promise<number> {
+  const adapter = Object.hasOwn(sourceAdapters, row.type) ? sourceAdapters[row.type as keyof typeof sourceAdapters] : undefined;
+  if (!adapter) throw new Error(`unknown source type ${row.type}`);
+  let parsed;
+  try { parsed = adapter.configSchema.safeParse(JSON.parse(row.config)); } catch { parsed = null; }
+  if (!parsed?.success) throw new Error('invalid config');
+  const config = parsed.data;
+
+  const res = await deps.fetchImpl(adapter.url(config), {
+    signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+    headers: { 'User-Agent': 'world-alerts/0.1' },
+  });
+  if (!res.ok) throw new Error(`HTTP ${res.status}`); // body deliberately not read into the error
+  const body = await res.text();
+  // normalize throws before ingest on a bad body, and ingest is one transaction: no partial events.
+  return ingest(db, adapter.normalize(body, config, deps.now()), deps.now()).inserted.length;
+}
+
+const message = (err: unknown): string => String((err as Error)?.message ?? err).slice(0, MAX_ERROR_LEN);
diff --git a/server/src/pipeline/scheduler.ts b/server/src/pipeline/scheduler.ts
new file mode 100644
index 0000000..18590aa
--- /dev/null
+++ b/server/src/pipeline/scheduler.ts
@@ -0,0 +1,46 @@
+import type { Database } from 'better-sqlite3';
+import type { ChannelAdapter } from '../channels';
+import { dispatchPending } from './dispatch';
+import { pollSource } from './poll';
+
+const TICK_MS = 10_000;
+
+export interface SchedulerDeps { fetchImpl: typeof fetch; registry: Record<string, ChannelAdapter<any>>; now: () => Date; log: (msg: string) => void }
+
+/** One scheduler tick: poll due sources sequentially, then dispatch. Never rejects. */
+export async function runTick(db: Database, deps: SchedulerDeps): Promise<{ polled: number; dispatch?: { sent: number; failed: number; retried: number } }> {
+  let polled = 0;
+  try {
+    const due = db.prepare(
+      `SELECT id, name FROM sources
+       WHERE enabled = 1 AND (last_polled_at IS NULL OR julianday(last_polled_at) <= julianday(?) - poll_interval_s / 86400.0)
+       ORDER BY id`,
+    ).all(deps.now().toISOString()) as { id: number; name: string }[];
+    for (const s of due) {
+      const r = await pollSource(db, s.id, deps);
+      polled++;
+      if (!r.ok) deps.log(`poll failed: source ${s.id} (${s.name}): ${r.error}`);
+    }
+  } catch (err) {
+    deps.log(`poll error: ${(err as Error)?.message ?? err}`);
+  }
+  try {
+    return { polled, dispatch: await dispatchPending(db, deps.registry, deps.now()) };
+  } catch (err) {
+    deps.log(`dispatch error: ${(err as Error)?.message ?? err}`);
+    return { polled };
+  }
+}
+
+export function startScheduler(db: Database, deps: SchedulerDeps): { stop(): void } {
+  let running = false;
+  const tick = async () => {
+    if (running) return; // previous tick still in flight
+    running = true;
+    try { await runTick(db, deps); } finally { running = false; }
+  };
+  void tick();
+  const timer = setInterval(tick, TICK_MS);
+  timer.unref();
+  return { stop: () => clearInterval(timer) };
+}
