+  const app = buildApp(db, { registry, fetchImpl: (async () => new Response('')) as typeof fetch, now: () => now, log: (m) => { logs.push(m); } });
+  const as = (user: number) => (method: 'GET' | 'POST' | 'PATCH' | 'DELETE', url: string, payload?: unknown) =>
+    app.inject({ method, url, headers: { 'x-user-id': String(user) }, ...(payload === undefined ? {} : { payload: payload as object }) });
