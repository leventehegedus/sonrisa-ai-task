+import Fastify, { type FastifyInstance } from 'fastify';
+import type { Database } from 'better-sqlite3';
+import { z } from 'zod';
+import type { ChannelAdapter } from '../channels';
+import { authenticate } from './auth';
+import { userRoutes } from './user-routes';
+
+export interface AppDeps { registry: Record<string, ChannelAdapter<any>>; fetchImpl: typeof fetch; now: () => Date; log: (msg: string) => void }
+
+// Error messages can echo request data or URLs: hide Slack webhook paths and URL credentials (e.g. SMTP_URL).
+const scrubLog = (s: string) => s.replace(/https:\/\/hooks\.slack\.com\/\S*/g, 'https://hooks.slack.com/…').replace(/\/\/[^\s/@]+@/g, '//***@');
+
+export function buildApp(db: Database, deps: AppDeps): FastifyInstance {
+  const app = Fastify({ logger: false });
+  app.decorateRequest('user', null as never);
+
+  app.setErrorHandler((err: any, req, reply) => {
+    if (err instanceof z.ZodError) return reply.code(400).send({ error: 'invalid request', issues: err.issues });
+    // Fastify's own client errors (malformed JSON, empty JSON body, unsupported media type, too large).
+    if (typeof err?.statusCode === 'number' && err.statusCode >= 400 && err.statusCode < 500) {
+      return reply.code(err.statusCode).send({ error: 'invalid request', message: String(err.message) });
+    }
+    deps.log(`http ${req.method} ${req.url.split('?')[0]}: ${scrubLog(String(err?.message ?? err))}`);
+    return reply.code(500).send({ error: 'internal error' });
+  });
+
+  app.register(async (api) => {
+    api.addHook('preHandler', authenticate(db));
+    await api.register(userRoutes(db, deps));
+  }, { prefix: '/api' });
+
+  return app;
+}
