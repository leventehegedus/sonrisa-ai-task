+    expect(res.statusCode).toBe(201);
+    expect(res.json()).toMatchObject({ deliveriesCreated: 2, event: { id: expect.any(Number), source: 'manual', title: 'Árvíz a Dunán', country: 'HU', scope: 'country', occurredAt: t0.toISOString() } });
