--- /dev/null
+++ b/web/src/api.test.ts
@@ -0,0 +1,106 @@
+import { createElement, type ReactNode } from 'react'
+import { Provider } from 'react-redux'
+import { act, renderHook, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { api, useGetMeQuery } from './api'
+import { setUser, switchUser } from './session'
+import { makeStore } from './store'
+
+const USERS: Record<string, { id: number; name: string }> = { '1': { id: 1, name: 'Anna' }, '2': { id: 2, name: 'Bence' } }
+let requests: Request[]
+
+beforeEach(() => {
+  localStorage.clear()
+  requests = []
+  // Node's Request rejects relative URLs; a browser resolves '/api/...' against the page origin.
+  const NodeRequest = Request
+  vi.stubGlobal('Request', class extends NodeRequest {
+    constructor(input: RequestInfo | URL, init?: RequestInit) {
+      super(typeof input === 'string' ? new URL(input, location.href) : input, init)
+    }
+  })
+  vi.stubGlobal('fetch', vi.fn(async (req: Request) => {
+    requests.push(req)
+    const user = USERS[req.headers.get('X-User-Id') ?? '']
+    return new Response(JSON.stringify(user ?? { error: 'unknown or missing X-User-Id' }), {
+      status: user ? 200 : 401, headers: { 'content-type': 'application/json' },
+    })
+  }))
+})
+afterEach(() => { vi.unstubAllGlobals(); vi.restoreAllMocks() })
+
+describe('api prepareHeaders', () => {
+  it('sends X-User-Id 1 by default', async () => {
+    const store = makeStore()
+    await store.dispatch(api.endpoints.getMe.initiate())
+    expect(requests[0].headers.get('X-User-Id')).toBe('1')
+  })
+
+  it('sends X-User-Id from the session state after setUser(2)', async () => {
+    const store = makeStore()
+    store.dispatch(setUser(2))
+    await store.dispatch(api.endpoints.getMe.initiate())
+    expect(requests[0].headers.get('X-User-Id')).toBe('2')
+  })
+
+  it('starts from the user id saved in localStorage', async () => {
+    localStorage.setItem('wa.userId', '2')
+    const store = makeStore()
+    await store.dispatch(api.endpoints.getMe.initiate())
+    expect(requests[0].headers.get('X-User-Id')).toBe('2')
+  })
+
+  it('falls back to user 1 when localStorage holds garbage or throws', () => {
+    localStorage.setItem('wa.userId', 'abc')
+    expect(makeStore().getState().session.userId).toBe(1)
+    vi.spyOn(Storage.prototype, 'getItem').mockImplementation(() => { throw new Error('blocked') })
+    expect(makeStore().getState().session.userId).toBe(1)
+  })
+})
+
+describe('switchUser', () => {
+  it('sets the user, persists it and resets the RTK Query cache', async () => {
+    const store = makeStore()
+    await store.dispatch(api.endpoints.getMe.initiate())
+    expect(Object.keys(store.getState().api.queries)).toHaveLength(1)
+
+    store.dispatch(switchUser(2))
+    expect(store.getState().session.userId).toBe(2)
+    expect(localStorage.getItem('wa.userId')).toBe('2')
+    expect(store.getState().api.queries).toEqual({})
+  })
+
+  it('still switches when localStorage throws on write', () => {
+    vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('quota') })
+    const store = makeStore()
+    store.dispatch(switchUser(2))
+    expect(store.getState().session.userId).toBe(2)
+  })
+
+  it('makes a mounted query refetch as the new user', async () => {
+    const store = makeStore()
+    const wrapper = ({ children }: { children: ReactNode }) => createElement(Provider, { store, children })
+    const { result } = renderHook(() => useGetMeQuery(), { wrapper })
+    await waitFor(() => expect(result.current.data?.name).toBe('Anna'))
+
+    act(() => { store.dispatch(switchUser(2)) })
+    await waitFor(() => expect(result.current.data?.name).toBe('Bence'))
+    expect(requests.map((r) => r.headers.get('X-User-Id'))).toEqual(['1', '2'])
+  })
+})
+
+describe('updateChannel', () => {
+  it('omits config from the PATCH body when not given', async () => {
+    const store = makeStore()
+    await store.dispatch(api.endpoints.updateChannel.initiate({ id: 5, enabled: false }))
+    expect(requests[0].method).toBe('PATCH')
+    expect(new URL(requests[0].url).pathname).toBe('/api/channels/5')
+    expect(await requests[0].json()).toEqual({ enabled: false })
+  })
+
+  it('sends config when given', async () => {
+    const store = makeStore()
+    await store.dispatch(api.endpoints.updateChannel.initiate({ id: 5, config: { to: 'a@example.com' } }))
+    expect(await requests[0].json()).toEqual({ config: { to: 'a@example.com' } })
+  })
+})
