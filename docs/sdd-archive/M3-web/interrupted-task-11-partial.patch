+import { createApi, fetchBaseQuery } from '@reduxjs/toolkit/query/react'
+import type { RootState } from './store'
+import type {
+  AdminDelivery, Channel, ChannelCreate, ChannelPatch, ChannelTestResult, Delivery, DeliveryStatus, EventRow,
+  InjectEventInput, InjectEventResult, PollResult, Rule, RuleCreate, RulePatch, Source, SourcePatch, User,
+} from './types'
+
+export const api = createApi({
+  baseQuery: fetchBaseQuery({
+    baseUrl: '/api',
+    prepareHeaders: (h, { getState }) => {
+      h.set('X-User-Id', String((getState() as RootState).session.userId))
+      return h
+    },
+  }),
+  tagTypes: ['Me', 'Rules', 'Channels', 'MyDeliveries', 'Users', 'AdminRules', 'Events', 'Deliveries', 'Sources'],
+  endpoints: (b) => ({
+    getMe: b.query<User, void>({ query: () => '/me', providesTags: ['Me'] }),
+
+    getRules: b.query<Rule[], void>({ query: () => '/rules', providesTags: ['Rules'] }),
+    getRule: b.query<Rule, number>({ query: (id) => `/rules/${id}`, providesTags: ['Rules'] }),
+    createRule: b.mutation<Rule, RuleCreate>({
+      query: (body) => ({ url: '/rules', method: 'POST', body }),
+      invalidatesTags: ['Rules', 'AdminRules'],
+    }),
+    updateRule: b.mutation<Rule, { id: number } & RulePatch>({
+      query: ({ id, ...body }) => ({ url: `/rules/${id}`, method: 'PATCH', body }),
+      invalidatesTags: ['Rules', 'AdminRules'],
+    }),
+    deleteRule: b.mutation<void, number>({
+      query: (id) => ({ url: `/rules/${id}`, method: 'DELETE' }),
+      invalidatesTags: ['Rules', 'AdminRules'],
+    }),
+
+    getChannels: b.query<Channel[], void>({ query: () => '/channels', providesTags: ['Channels'] }),
+    getChannel: b.query<Channel, number>({ query: (id) => `/channels/${id}`, providesTags: ['Channels'] }),
+    createChannel: b.mutation<Channel, ChannelCreate>({
+      query: (body) => ({ url: '/channels', method: 'POST', body }),
+      invalidatesTags: ['Channels'],
+    }),
+    // Pass `config` only when the user edited it: responses carry the masked webhook, which the server rejects as input.
+    // An omitted (undefined) key is dropped by JSON serialisation, so the server keeps the stored config.
+    updateChannel: b.mutation<Channel, { id: number } & ChannelPatch>({
+      query: ({ id, ...body }) => ({ url: `/channels/${id}`, method: 'PATCH', body }),
+      invalidatesTags: ['Channels'],
+    }),
+    // The server drops the id from rules and fails pending deliveries for the channel.
+    deleteChannel: b.mutation<void, number>({
+      query: (id) => ({ url: `/channels/${id}`, method: 'DELETE' }),
+      invalidatesTags: ['Channels', 'Rules', 'AdminRules', 'MyDeliveries', 'Deliveries'],
+    }),
+    // Sends directly, outside the outbox: nothing to invalidate.
+    testChannel: b.mutation<ChannelTestResult, number>({ query: (id) => ({ url: `/channels/${id}/test`, method: 'POST' }) }),
+
+    getMyDeliveries: b.query<Delivery[], void>({ query: () => '/my/deliveries', providesTags: ['MyDeliveries'] }),
+
+    getUsers: b.query<User[], void>({ query: () => '/admin/users', providesTags: ['Users'] }),
+    getAdminRules: b.query<Rule[], void>({ query: () => '/admin/rules', providesTags: ['AdminRules'] }),
+    getEvents: b.query<EventRow[], { limit?: number } | void>({
+      query: (arg) => ({ url: '/admin/events', params: arg?.limit ? { limit: arg.limit } : undefined }),
+      providesTags: ['Events'],
+    }),
+    getDeliveries: b.query<AdminDelivery[], { status?: DeliveryStatus } | void>({
+      query: (arg) => ({ url: '/admin/deliveries', params: arg?.status ? { status: arg.status } : undefined }),
+      providesTags: ['Deliveries'],
+    }),
+    retryDelivery: b.mutation<AdminDelivery, number>({
+      query: (id) => ({ url: `/admin/deliveries/${id}/retry`, method: 'POST' }),
+      invalidatesTags: ['Deliveries', 'MyDeliveries'],
+    }),
+    getSources: b.query<Source[], void>({ query: () => '/admin/sources', providesTags: ['Sources'] }),
+    updateSource: b.mutation<Source, { id: number } & SourcePatch>({
+      query: ({ id, ...body }) => ({ url: `/admin/sources/${id}`, method: 'PATCH', body }),
+      invalidatesTags: ['Sources'],
+    }),
+    pollSource: b.mutation<PollResult, number>({
+      query: (id) => ({ url: `/admin/sources/${id}/poll`, method: 'POST' }),
+      invalidatesTags: ['Sources', 'Events', 'Deliveries', 'MyDeliveries'],
+    }),
+    injectEvent: b.mutation<InjectEventResult, InjectEventInput>({
+      query: (body) => ({ url: '/admin/events', method: 'POST', body }),
+      invalidatesTags: ['Events', 'Deliveries', 'MyDeliveries'],
+    }),
+  }),
+})
+
+export const {
+  useGetMeQuery,
+  useGetRulesQuery, useGetRuleQuery, useCreateRuleMutation, useUpdateRuleMutation, useDeleteRuleMutation,
+  useGetChannelsQuery, useGetChannelQuery, useCreateChannelMutation, useUpdateChannelMutation, useDeleteChannelMutation, useTestChannelMutation,
+  useGetMyDeliveriesQuery,
+  useGetUsersQuery, useGetAdminRulesQuery, useGetEventsQuery, useGetDeliveriesQuery, useRetryDeliveryMutation,
+  useGetSourcesQuery, useUpdateSourceMutation, usePollSourceMutation, useInjectEventMutation,
+} = api
