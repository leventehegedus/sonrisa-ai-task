+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'
+import { useGetUsersQuery } from '@/api'
+import { switchUser } from '@/session'
+import { useAppDispatch, useAppSelector } from '@/store'
+
+const FALLBACK = [1, 2, 3].map((id) => ({ id, name: `User ${id}` }))
+
+// shortcut: dev user switcher stands in for login, replace with real auth before any deployment
+export function UserSwitcher() {
+  const dispatch = useAppDispatch()
+  const userId = useAppSelector((s) => s.session.userId)
+  // Only admins may list users: a non-admin gets 403 and sees ids 1–3. Any other failure (e.g. 401 for a
+  // stale saved id) falls back too, so the user can always switch back to a known id.
+  const { data } = useGetUsersQuery()
+  const users = data ?? FALLBACK
+
+  return (
+    <Select value={String(userId)} onValueChange={(v) => dispatch(switchUser(Number(v)))}>
+      <SelectTrigger className="w-40" aria-label="Acting user">
+        <SelectValue placeholder={`User ${userId}`} />
+      </SelectTrigger>
+      <SelectContent>
