+// localStorage can be missing or throw (private mode, blocked storage): fall back to user 1 / skip persisting.
+function loadUserId(): number {
+  try {
+    const id = Number(localStorage.getItem(KEY))
+    return Number.isInteger(id) && id > 0 ? id : 1
+  } catch {
+    return 1
+  }
+}
+
+export const sessionSlice = createSlice({
+  name: 'session',
+  initialState: () => ({ userId: loadUserId() }),
+  reducers: {
+    setUser(state, action: PayloadAction<number>) { state.userId = action.payload },
+  },
+})
+export const { setUser } = sessionSlice.actions
+
+/** Switch the acting user, persist the choice and drop every cached response (they belong to the old user). */
+export const switchUser = (id: number) => (dispatch: AppDispatch) => {
+  try { localStorage.setItem(KEY, String(id)) } catch { /* not persisted; the switch still applies */ }
+  dispatch(setUser(id))
+  dispatch(api.util.resetApiState())
+}
