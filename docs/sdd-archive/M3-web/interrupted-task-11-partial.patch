+++ b/web/src/types.ts
@@ -0,0 +1,49 @@
+// shortcut: duplicated types from server/src (types.ts, db/rows.ts, route schemas), move to a shared workspace package when they start drifting
+
+export type Category = 'news' | 'market' | 'disaster';
+export type Scope = 'country' | 'global' | 'unknown';
+export type DeliveryStatus = 'pending' | 'sent' | 'failed';
+export type ProximityReason = 'home' | 'subregion' | 'continent' | 'elsewhere' | 'global' | 'unknown';
+
+export interface ApiError { error: string; issues?: unknown[] }
+
+export interface User { id: number; name: string; email: string; homeCountry: string; isAdmin: boolean }
+
+export interface Rule { id: number; userId: number; name: string; categories: Category[]; keywords: string[]; threshold: number; channelIds: number[]; enabled: boolean }
+/** POST /rules: only `name` is required, the server fills the rest with defaults. */
+export type RuleCreate = Pick<Rule, 'name'> & Partial<Pick<Rule, 'categories' | 'keywords' | 'threshold' | 'channelIds' | 'enabled'>>;
+export type RulePatch = Partial<Pick<Rule, 'name' | 'categories' | 'keywords' | 'threshold' | 'channelIds' | 'enabled'>>;
+
+export interface EmailConfig { to: string }
+/** In responses `webhookUrl` is masked (`https://hooks.slack.com/…/XXXX`). */
+export interface SlackConfig { webhookUrl: string }
+export type ChannelType = 'email' | 'slack';
+export interface Channel { id: number; type: ChannelType; config: EmailConfig | SlackConfig; enabled: boolean }
+/** Email `config` is optional (the server defaults `to` to the user's email). */
+export interface ChannelCreate { type: ChannelType; config?: Partial<EmailConfig> | SlackConfig; enabled?: boolean }
+export interface ChannelPatch { config?: Partial<EmailConfig> | SlackConfig; enabled?: boolean }
+export interface ChannelTestResult { ok: boolean; error?: string }
+
+export interface ScoreBreakdown { severity: number; proximity: number; proximityReason: ProximityReason; override: boolean; importance: number; threshold: number; fires: boolean }
+export interface EventRow {
+  id: number; source: string; externalId: string; category: Category; title: string; summary: string | null; url: string | null;
+  scope: Scope; country: string | null; severity: number; occurredAt: string; raw: unknown;
+}
+export interface Delivery {
+  id: number; status: DeliveryStatus; attempts: number; lastError: string | null; createdAt: string; sentAt: string | null;
+  channelId: number | null; ruleId: number | null; breakdown: ScoreBreakdown;
+  event: Pick<EventRow, 'id' | 'title' | 'category' | 'country' | 'scope' | 'url' | 'occurredAt'>;
+}
+/** Owner = the rule's user, or the channel's when the rule was deleted. */
+export interface AdminDelivery extends Delivery { userId: number | null }
+
+export interface Source {
+  id: number; type: string; name: string; config: unknown; enabled: boolean; pollIntervalS: number;
+  lastPolledAt: string | null; lastError: string | null; baselineAt: string | null;
+}
+export interface SourcePatch { enabled?: boolean; pollIntervalS?: number }
+export interface PollResult { ok: boolean; inserted: number; error?: string }
+
+/** POST /admin/events. `country` is ISO2; omit it for a global event. */
+export interface InjectEventInput { category: Category; title: string; summary?: string; url?: string; country?: string; severity: number }
+export interface InjectEventResult { event: EventRow; deliveriesCreated: number }
