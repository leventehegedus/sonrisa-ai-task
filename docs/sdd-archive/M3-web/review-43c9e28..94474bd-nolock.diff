+          <TableHead>Status</TableHead>
+          <TableHead>Why</TableHead>
+        </TableRow>
+      </TableHeader>
+      <TableBody>
+        {data.map((d) => (
+          <TableRow key={d.id}>
+            <TableCell>{new Date(d.createdAt).toLocaleString()}</TableCell>
+            <TableCell className="whitespace-normal">
